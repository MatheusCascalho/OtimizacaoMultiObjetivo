{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: teste MDS (arquivo fixo)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_mds.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Debug: arquivo atual",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "justMyCode": true
        }
    ]
}